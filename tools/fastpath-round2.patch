+
+    private fun registerCurtainFrameCommit(
+        curtain: View,
+        generation: Long,
+        eventDetectedAtNanos: Long
+    ) {
+        if (eventDetectedAtNanos <= 0L || Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return
+        val observer = curtain.viewTreeObserver
+        if (!observer.isAlive) return
+        observer.registerFrameCommitCallback {
+            val frameCommittedAtNanos = SystemClock.elapsedRealtimeNanos()
+            val eventToFrameMicros =
+                (frameCommittedAtNanos - eventDetectedAtNanos).coerceAtLeast(0L) / 1_000L
+            scope.launch {
+                FocusGuardLogger.log(
+                    "A11yLatency",
+                    "Autoproteção: geração=$generation, evento→frameCommit=${eventToFrameMicros}µs"
+                )
+            }
+        }
+    }
