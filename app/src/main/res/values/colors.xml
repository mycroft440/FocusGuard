<?xml version="1.0" encoding="utf-8"?>
<!--
  Espelho em XML da paleta do Compose (FocusGuardTheme.kt).

  Os dois arquivos precisam bater: a barra de status e a barra de navegação do
  sistema saem daqui, e quando o valor divergia do fundo desenhado pelo Compose
  aparecia uma faixa mais clara colada no topo e no rodapé de toda tela.
-->
<resources>
    <!-- Dark Theme Base -->
    <color name="dark_bg">#FF05080B</color>
    <color name="dark_surface">#FF0E141B</color>
    <color name="dark_card">#FF141B23</color>
    <color name="dark_card_elevated">#FF171F29</color>

    <!-- Gradient Colors -->
    <color name="gradient_start">#FF8FE3F5</color>
    <color name="gradient_mid">#FF5CCFE6</color>
    <color name="gradient_end">#FF2C93AE</color>

    <!-- Accent Colors -->
    <color name="accent_cyan">#FF5CCFE6</color>
    <color name="accent_cyan_dark">#FF3AAFC5</color>
    <color name="accent_purple">#FF7C4DFF</color>
    <color name="accent_purple_dark">#FF5E35B1</color>

    <!-- Semantic Colors -->
    <color name="success_green">#FF4CAF50</color>
    <color name="warning_amber">#FFFFC107</color>
    <color name="danger_red">#FFE53935</color>
    <color name="danger_red_dark">#FFC62828</color>
    <color name="info_blue">#FF2196F3</color>

    <!-- Text Colors -->
    <color name="text_primary">#FFEDF2F7</color>
    <color name="text_secondary">#FF93A1AD</color>
    <color name="text_hint">#FF78848F</color>
    <color name="text_disabled">#FF46515A</color>

    <!-- Borders & Dividers -->
    <color name="border">#FF222C36</color>
    <color name="border_subtle">#FF18212A</color>
    <color name="divider">#FF222C36</color>
    <color name="card_border">#FF222C36</color>

    <!-- Overlay -->
    <color name="overlay_dark">#CC000000</color>
    <color name="ripple_light">#1AFFFFFF</color>

    <!-- Legacy (kept for compatibility) -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="red">#FFFF0000</color>
    <color name="green">#FF00FF00</color>
    <color name="muted">#FF666666</color>
    <color name="orange">#FFFFA500</color>
    <color name="gray_200">#FFEEEEEE</color>
    <color name="gray_500">#FF9E9E9E</color>
    <color name="gray_700">#FF616161</color>
    <color name="ic_launcher_background">#FF1A1A2E</color>
</resources>
