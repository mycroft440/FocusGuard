<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pomodoro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pomodoro_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_pomodoro_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pomodoro_widget_title"
        android:textColor="#F4F7FA"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_pomodoro_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="#B8C4CC"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_pomodoro_sessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textColor="#8FA2AF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_pomodoro_start"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_pomodoro_button_bg"
        android:gravity="center"
        android:text="@string/pomodoro_widget_start"
        android:textColor="#071418"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
